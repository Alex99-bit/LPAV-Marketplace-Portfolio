# ============================================================
# LPAV Marketplace - Variables de Entorno
# ============================================================
# Copia este archivo como .env y completa los valores.
# NUNCA subas el .env real al repositorio.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# --- Gemini AI ---
GEMINI_API_KEY=AIzaSy-tu-api-key

# --- Stripe (Marketplace / Connect) ---
# Clave secreta de la PLATAFORMA (nunca se expone al frontend).
#   https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Secreto de firma de webhooks (endpoint /stripe-marketplace-webhook).
#   https://dashboard.stripe.com/webhooks -> "Signing secret" (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...

# Client ID de Stripe Connect (OAuth de cuentas Express, opcional).
#   https://dashboard.stripe.com/settings/connect
STRIPE_CONNECT_CLIENT_ID=

# --- Stripe Billing: IDs de precios de suscripción (SaaS) ---
#   https://dashboard.stripe.com/pricing  (cada Price tiene un id "price_...")
#   Los valores por defecto en manage-subscription son los de la cuenta de prueba.
STRIPE_PRICE_INTERMEDIO_MONTHLY=price_1U1htg0Fcaofr3eiDSlvaSgj
STRIPE_PRICE_INTERMEDIO_ANNUAL=price_1U1htg0Fcaofr3ei3XqqLPIP
STRIPE_PRICE_PREMIUM_MONTHLY=price_1U1huB0Fcaofr3eid0ynTayJ
STRIPE_PRICE_PREMIUM_ANNUAL=price_1U1hvx0Fcaofr3eihlvRrRAR
# Precio de Continuidad Fundador (Opción A: $2,999 MXN/mes)
STRIPE_PRICE_FUNDADOR_CONTINUITY_MONTHLY=price_1U6mgj0Fcaofr3eiYwW5plXb

# --- Resend (Email) ---
RESEND_API_KEY=

# --- Twenty CRM (pendiente de activar) ---
TWENTY_CRM_API_KEY=
TWENTY_CRM_URL=http://localhost:3000

# --- Twenty CRM SSO ---
VITE_TWENTY_CRM_URL=http://localhost:3000
TWENTY_CRM_SSO_SECRET=

# --- Facturama (facturación fiscal CFDI) ---
FACTURAMA_API_KEY=
FACTURAMA_API_URL=https://api.facturama.mx/2/

# --- App ---
VITE_APP_URL=http://localhost:5173
